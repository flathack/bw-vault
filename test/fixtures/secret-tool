#!/bin/bash
# Stand-in for libsecret's secret-tool, so the fixture run cannot read or
# overwrite the real keyring. Entries are files under a temp directory; a fake
# unlock therefore cannot clobber the real Bitwarden session token.
set -uo pipefail
state="${BW_FIXTURE_STATE:-${XDG_RUNTIME_DIR:-/tmp}/bw-vault-fixture}/keyring"
mkdir -p "$state"

key() {  # collapse the trailing attribute pairs into one filename
  local out="" ; shift  # drop the subcommand
  while (( $# )); do
    [[ $1 == --* ]] && { shift; continue; }
    out+="${1}_"; shift
  done
  echo "${out//\//_}"
}

case "${1:-}" in
store)  cat > "$state/$(key "$@")" ;;
lookup) f="$state/$(key "$@")"; [[ -f $f ]] || exit 1; cat "$f" ;;
clear)  rm -f "$state/$(key "$@")" ;;
*) exit 1 ;;
esac
