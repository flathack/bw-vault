#!/bin/bash
set -euo pipefail
registry="${XDG_STATE_HOME:-$HOME/.local/state}/bw-vault/endpoints.json"
if [[ -f $registry ]]; then
  selected=$(jq -r '.selected // "default"' "$registry")
  managed=$(jq -r --arg id "$selected" '.endpoints[] | select(.id == $id) | .managed // false' "$registry")
  if [[ $selected =~ ^(default|[0-9a-f]{16})$ && ( $selected != default || $managed == true ) ]]; then
    export BITWARDENCLI_APPDATA_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/bw-vault/cli/$selected"
  fi
fi
exec bw "$@"
