#!/bin/bash
set -euo pipefail
registry="${XDG_STATE_HOME:-$HOME/.local/state}/bw-vault/endpoints.json"
selected=default
if [[ -f $registry ]]; then selected=${BW_VAULT_ENDPOINT_ID:-$(jq -r '.selected // "default"' "$registry")}; fi
[[ $selected =~ ^(default|[0-9a-f]{16})$ ]] || exit 1
args=("$@")
for ((i=0;i<${#args[@]}-1;i++)); do
  if [[ ${args[i]} == account && $selected != default ]]; then
    args[i+1]="${args[i+1]}-$selected"
  fi
done
exec secret-tool "${args[@]}"
