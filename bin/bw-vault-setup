#!/bin/bash

# Store a Bitwarden personal API key in the OS keyring, once per machine.
#
# This is a terminal command rather than a screen in the plugin because of how
# the key is obtained: you copy client_id and client_secret out of a browser,
# one at a time. A bar dropdown dismisses on any click outside it, so the trip
# back to the browser for the second value would close the form and lose the
# first. A terminal does not have that problem.
#
# Afterwards the dropdown only ever asks for your master password.
#
# Get the key from: Bitwarden web vault -> Account Settings -> Security ->
# Keys -> View API Key.

set -euo pipefail

SERVICE="com.aktivesolutions.bw-vault"
ID_ACCOUNT="bw-client-id"
SECRET_ACCOUNT="bw-client-secret"

fail() {
  echo "bw-vault-setup: $*" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
Usage: bw-vault-setup [--show | --clear]

Stores your Bitwarden personal API key (client_id / client_secret) in the OS
keyring, so the FlatVault dropdown only has to ask for your master password.

  (no args)  prompt for client_id and client_secret and store them
  --show     report whether a key is stored (never prints the secret)
  --clear    remove the stored key from the keyring

Get the key from the Bitwarden web vault:
  Account Settings -> Security -> Keys -> View API Key
USAGE
}

command -v secret-tool >/dev/null 2>&1 || fail "secret-tool not found — install libsecret"
secret_cmd="$(dirname "$0")/bw-vault-secret"

case "${1:-}" in
-h | --help)
  usage
  exit 0
  ;;
--show)
  if "$secret_cmd" lookup service "$SERVICE" account "$ID_ACCOUNT" >/dev/null 2>&1; then
    # The id is not a secret, so it is safe to echo; the secret never is.
    id=$("$secret_cmd" lookup service "$SERVICE" account "$ID_ACCOUNT")
    if "$secret_cmd" lookup service "$SERVICE" account "$SECRET_ACCOUNT" >/dev/null 2>&1; then
      echo "client_id:     $id"
      echo "client_secret: stored"
    else
      echo "client_id:     $id"
      echo "client_secret: MISSING — rerun bw-vault-setup"
      exit 1
    fi
  else
    echo "No API key stored."
    exit 1
  fi
  exit 0
  ;;
--clear)
  "$secret_cmd" clear service "$SERVICE" account "$ID_ACCOUNT" 2>/dev/null || true
  "$secret_cmd" clear service "$SERVICE" account "$SECRET_ACCOUNT" 2>/dev/null || true
  echo "Stored API key removed."
  exit 0
  ;;
"") ;;
*)
  fail "unknown option: $1"
  ;;
esac

[[ -t 0 ]] || fail "run this in a terminal — it prompts for the API key"

cat <<'INTRO'
FlatVault setup

Open your Bitwarden web vault and go to:
  Account Settings -> Security -> Keys -> View API Key

INTRO

# The id is not a secret and echoing it lets you check the paste landed.
read -r -p "client_id: " client_id
[[ -n $client_id ]] || fail "client_id is required"

# The secret is: read it with the terminal echo off, the same way a password
# prompt does, so it never appears on screen or in scrollback.
read -r -s -p "client_secret: " client_secret
echo
[[ -n $client_secret ]] || fail "client_secret is required"

# Piped into secret-tool's stdin rather than passed as an argument, so neither
# value is ever visible in the process list.
printf '%s' "$client_id" | "$secret_cmd" store --label="FlatVault client ID" \
  service "$SERVICE" account "$ID_ACCOUNT" ||
  fail "could not write the client id to the keyring"

printf '%s' "$client_secret" | "$secret_cmd" store --label="FlatVault client secret" \
  service "$SERVICE" account "$SECRET_ACCOUNT" ||
  fail "could not write the client secret to the keyring"

unset client_secret

echo
echo "Stored. Open the vault dropdown and enter your master password to unlock."
